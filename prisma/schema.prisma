// Portal de Carreiras — WG Baterias
// Prisma Schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Usuários internos (RH) ───────────────────────────────────────────────────

enum UserRole {
  ADMIN_RH // Acesso total: criar/editar/encerrar vagas
  VIEWER_RH // Somente leitura: ver vagas
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER_RH)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// NextAuth sessions (opcional — usado se migrar para OAuth)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  @@map("sessions")
}

// ─── Vagas ────────────────────────────────────────────────────────────────────

enum JobStatus {
  DRAFT // Rascunho — visível só no painel, não aparece no portal
  ACTIVE // Publicada no portal (aberta)
  SCREENING // Triagem — etapa interna; vaga segue visível no portal
  INTERVIEW // Entrevistas — etapa interna; vaga segue visível no portal
  ADMISSION // Admissão — etapa interna; vaga segue visível no portal
  PAUSED // Pausada temporariamente (não aparece no portal)
  CLOSED // Cancelada/Encerrada (não aparece no portal)
}

enum Modality {
  PRESENTIAL // Presencial
  REMOTE // Remoto
  HYBRID // Híbrido
}

enum ContractType {
  CLT
  PJ
  INTERNSHIP // Estágio
  APPRENTICE // Jovem aprendiz
  TEMPORARY // Temporário
  OTHER
}

// Prioridade da vaga no processo de R&S (usada em filtros, ordenação e badges)
enum JobPriority {
  LOW // Baixa
  MEDIUM // Média (padrão)
  HIGH // Alta
  URGENT // Urgente
}

// Etapas do funil de seleção (colunas do Kanban)
enum ApplicationStage {
  NEW // Novo
  SCREENING // Triagem
  INTERVIEW // Entrevista
  OFFER // Proposta
  HIRED // Contratado
  REJECTED // Reprovado
}

model Job {
  id                   String       @id @default(cuid())
  title                String
  department           String?
  company              String? // Empresa / unidade (ex: "WG Baterias SP")
  city                 String
  state                String // UF (ex: "SP")
  modality             Modality
  contractType         ContractType @default(CLT)
  description          String       @db.Text
  responsibilities     String       @db.Text
  requiredRequirements String       @db.Text
  desiredRequirements  String?      @db.Text
  benefits             String?      @db.Text
  workSchedule         String? // Ex: "Seg a Sex, 08h-17h"
  salaryRange          String? // Faixa salarial (ex: "R$ 2.500 – R$ 3.000")
  openings             Int? // Quantidade de vagas
  highlightBenefit     String? // Benefício em destaque (ex: "Plano de Saúde")
  responsible          String? // Recrutador responsável pelo processo
  slug                 String?      @unique
  closingDate          DateTime?
  hiringDeadline       DateTime? // Prazo interno alvo de contratação
  priority             JobPriority  @default(MEDIUM) // Prioridade no processo de R&S
  status               JobStatus    @default(ACTIVE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  statusHistory JobStatusHistory[]
  applications  Application[]

  @@map("jobs")
}

// ─── Candidaturas (inscrições nativas do portal) ──────────────────────────────
// LGPD: dados pessoais NUNCA são expostos publicamente — acesso só na área
// autenticada. O currículo fica em storage privado (Vercel Blob), acessível
// apenas via rota autenticada com URL assinada de curta duração.

model Application {
  id         String           @id @default(cuid())
  jobId      String
  job        Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fullName   String
  email      String
  phone      String
  resumeUrl  String? // URL privada no Vercel Blob (não pública)
  resumeName String? // Nome original do arquivo enviado
  stage      ApplicationStage @default(NEW)
  notes      String?          @db.Text // Anotações internas do RH
  consentAt  DateTime // Momento do consentimento LGPD
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  stageHistory ApplicationStageHistory[]

  @@index([jobId, stage])
  @@index([createdAt])
  @@map("applications")
}

model ApplicationStageHistory {
  id            String           @id @default(cuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage         ApplicationStage
  changedBy     String
  changedAt     DateTime         @default(now())

  @@map("application_stage_history")
}

model JobStatusHistory {
  id        String    @id @default(cuid())
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    JobStatus
  changedBy String
  changedAt DateTime  @default(now())

  @@map("job_status_history")
}

// ─── Configurações da Homepage ────────────────────────────────────────────────

model HomepageConfig {
  id                   String   @id
  showDepartment       Boolean  @default(true)
  showLocation         Boolean  @default(true)
  showModality         Boolean  @default(true)
  showContractType     Boolean  @default(true)
  showCompany          Boolean  @default(false)
  showWorkSchedule     Boolean  @default(false)
  showSalary           Boolean  @default(false)
  showHighlightBenefit Boolean  @default(false)
  showOpenings         Boolean  @default(false)
  showFilters          Boolean  @default(true)
  showJobCounter       Boolean  @default(true)
  jobsSectionTitle     String   @default("Vagas abertas")
  jobsSectionSubtitle  String   @default("Encontre a oportunidade ideal para crescer com o Grupo WG.")
  updatedAt            DateTime @updatedAt

  @@map("homepage_config")
}

// ════════════════════════════════════════════════════════════════════════════
// ADMISSÕES (onboarding) — port nativo do antigo app wg-admissao (Supabase).
//
// Módulo separado das vagas por ora. A autorização, que no Supabase era feita
// por RLS, aqui é feita em app code (sessão NextAuth + role). Referências ao
// ator (responsável, criado por, autor) são campos String simples com o
// User.id — mesma convenção do `changedBy` das vagas —, evitando poluir o
// model User com dezenas de back-relations.
//
// Ganchos de integração vaga→admissão estão plantados porém DESLIGADOS:
// Admission.sourceApplicationId / sourceJobId (colunas nuláveis, sem FK ainda).
// ════════════════════════════════════════════════════════════════════════════

// Status de um item de checklist da admissão.
enum ChecklistItemStatus {
  PENDING // Pendente
  IN_PROGRESS // Em andamento
  DONE // Concluído
  NOT_APPLICABLE // Não aplicável
}

// ─── Tabelas de configuração (editáveis no painel) ────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admissions Admission[]

  @@map("admission_companies")
}

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admissions Admission[]

  @@map("admission_branches")
}

model Position {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admissions Admission[]
  templates  ChecklistTemplate[]

  @@map("admission_positions")
}

// Etapas do Kanban de admissão (distinto de ApplicationStage, que é do ATS).
model AdmissionStage {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#94a3b8")
  icon      String?
  sortOrder Int      @default(0)
  isFinal   Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admissions Admission[]

  @@map("admission_stages")
}

model DocumentType {
  id        String   @id @default(cuid())
  name      String   @unique
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  attachments AdmissionAttachment[]

  @@map("admission_document_types")
}

model AdmissionTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#64748b")
  createdAt DateTime @default(now())

  admissions Admission[] // m2m implícito (join _AdmissionToAdmissionTag)

  @@map("admission_tags")
}

// ─── Modelos de checklist (por cargo) ─────────────────────────────────────────

model ChecklistTemplate {
  id          String    @id @default(cuid())
  name        String
  description String?
  positionId  String?
  position    Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  isDefault   Boolean   @default(false)
  active      Boolean   @default(true)
  createdById String? // User.id (sem FK, convenção changedBy)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  groups     TemplateGroup[]
  admissions Admission[]

  @@map("admission_checklist_templates")
}

model TemplateGroup {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())

  items TemplateItem[]

  @@map("admission_template_groups")
}

model TemplateItem {
  id                   String        @id @default(cuid())
  groupId              String
  group                TemplateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  sortOrder            Int           @default(0)
  defaultDaysFromStart Int? // prazo padrão = start_date + N dias
  createdAt            DateTime      @default(now())

  @@map("admission_template_items")
}

// ─── Admissões ────────────────────────────────────────────────────────────────

model Admission {
  id              String             @id @default(cuid())
  fullName        String
  cpf             String?
  email           String?
  phone           String?
  birthDate       DateTime?          @db.Date
  positionId      String?
  position        Position?          @relation(fields: [positionId], references: [id], onDelete: SetNull)
  companyId       String?
  company         Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branchId        String?
  branch          Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  stageId         String?
  stage           AdmissionStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  templateId      String?
  template        ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  responsibleId   String? // User.id (sem FK)
  managerName     String?
  startDate       DateTime?          @db.Date
  medicalExamDate DateTime?          @db.Date
  salary          Decimal?           @db.Decimal(12, 2)
  shift           String?
  uniformSize     String?
  notes           String?            @db.Text

  // Ganchos de integração vaga→admissão (DESLIGADOS; viram FK quando ativarmos).
  sourceApplicationId String?
  sourceJobId         String?

  createdById String? // User.id (sem FK)
  updatedById String? // User.id (sem FK)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft-delete (o app filtra deletedAt IS NULL)

  tags            AdmissionTag[]
  checklistGroups ChecklistGroup[]
  checklistItems  ChecklistItem[]
  attachments     AdmissionAttachment[]
  activities      AdmissionActivity[]
  notifications   AdmissionNotification[]

  @@index([stageId])
  @@index([createdAt(sort: Desc)])
  @@index([startDate])
  @@map("admissions")
}

// ─── Checklist da admissão (instanciado a partir do template) ──────────────────

model ChecklistGroup {
  id          String    @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  name        String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  items ChecklistItem[]

  @@map("admission_checklist_groups")
}

model ChecklistItem {
  id            String              @id @default(cuid())
  groupId       String
  group         ChecklistGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  admissionId   String
  admission     Admission           @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  status        ChecklistItemStatus @default(PENDING)
  responsibleId String? // User.id (sem FK)
  dueDate       DateTime?           @db.Date
  completedAt   DateTime?
  completedById String? // User.id (sem FK)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  comments    ChecklistComment[]
  attachments AdmissionAttachment[]

  @@index([admissionId])
  @@index([dueDate])
  @@map("admission_checklist_items")
}

model ChecklistComment {
  id        String        @id @default(cuid())
  itemId    String
  item      ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  authorId  String // User.id (sem FK)
  body      String        @db.Text
  createdAt DateTime      @default(now())

  @@map("admission_checklist_comments")
}

// ─── Anexos, log e notificações ───────────────────────────────────────────────

model AdmissionAttachment {
  id             String         @id @default(cuid())
  admissionId    String
  admission      Admission      @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  itemId         String?
  item           ChecklistItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  documentTypeId String?
  documentType   DocumentType?  @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  fileName       String
  blobUrl        String // URL privada no Vercel Blob (substitui storage_path do Supabase)
  mimeType       String?
  sizeBytes      BigInt?
  uploadedById   String? // User.id (sem FK)
  createdAt      DateTime       @default(now())

  @@index([admissionId])
  @@map("admission_attachments")
}

model AdmissionActivity {
  id          BigInt     @id @default(autoincrement())
  userId      String? // User.id (sem FK)
  admissionId String?
  admission   Admission? @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  entity      String
  entityId    String?
  action      String
  description String?
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([admissionId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("admission_activity_log")
}

model AdmissionNotification {
  id          String     @id @default(cuid())
  userId      String // User.id (sem FK)
  admissionId String?
  admission   Admission? @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  title       String
  body        String?
  readAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId, readAt])
  @@map("admission_notifications")
}
