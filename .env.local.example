# =============================================================
# PORTAL DE CARREIRAS — WG BATERIAS
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local — ele está no .gitignore.
# =============================================================

# Banco de dados (PostgreSQL — Neon ou outro)
# Formato: postgresql://user:password@host:5432/dbname?sslmode=require
# NOTA: em migração para o Supabase — o Neon segue ativo até o cutover (Fase 6).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Supabase (migração em andamento — banco + storage + auth)
# Project URL e keys: Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://XXXXXXXX.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...anon"
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role"   # server-only, bypassa RLS — NUNCA no browser
# Connection string (Dashboard → botão Connect → Session pooler) — usada p/ aplicar migrations
SUPABASE_DB_URL="postgresql://postgres.REF:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# NextAuth.js
# Gere com: openssl rand -base64 32  (ou qualquer string longa aleatória)
NEXTAUTH_SECRET="GERE_UMA_STRING_ALEATORIA_LONGA_AQUI"
NEXTAUTH_URL="http://localhost:3000"

# Claude API (Anthropic)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-XXXXXXXXXXXXX"

# Resend (e-mails transacionais)
# Obtenha em: https://resend.com/
RESEND_API_KEY="re_XXXXXXXXXXXXX"
RESEND_FROM_EMAIL="carreiras@wgbaterias.com.br"

# Upload de currículos e anexos — Supabase Storage (buckets privados `resumes` e
# `admission-attachments`, LGPD-safe). Não requer variável dedicada: o acesso é
# server-side via SUPABASE_SERVICE_ROLE_KEY (já definida acima). Os buckets são
# criados pela migração supabase/migrations/20260720000002_storage.sql.

# reCAPTCHA v3 (proteção do formulário de inscrição)
# Crie um par de chaves em: https://www.google.com/recaptcha/admin/create
# Tipo: reCAPTCHA v3. Adicione seus domínios (localhost + domínio de produção).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6LXXXXXXXXXXXXXXXXXXXXXX"
RECAPTCHA_SECRET_KEY="6LXXXXXXXXXXXXXXXXXXXXXX"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Carreiras WG Baterias"
