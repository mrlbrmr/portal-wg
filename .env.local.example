# =============================================================
# PORTAL DE CARREIRAS — WG BATERIAS
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local — ele está no .gitignore.
# =============================================================

# Banco de dados (PostgreSQL — Neon ou outro)
# Formato: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth.js
# Gere com: openssl rand -base64 32  (ou qualquer string longa aleatória)
NEXTAUTH_SECRET="GERE_UMA_STRING_ALEATORIA_LONGA_AQUI"
NEXTAUTH_URL="http://localhost:3000"

# Claude API (Anthropic)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-XXXXXXXXXXXXX"

# Resend (e-mails transacionais)
# Obtenha em: https://resend.com/
RESEND_API_KEY="re_XXXXXXXXXXXXX"
RESEND_FROM_EMAIL="carreiras@wgbaterias.com.br"

# Upload de currículos — Vercel Blob (storage privado, LGPD-safe)
# Provisionado automaticamente ao habilitar o Blob no projeto Vercel:
# Vercel Dashboard → Storage → Create → Blob → Connect Project.
# Depois rode `vercel env pull .env.local` OU copie o token abaixo.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXXXXXXX"

# reCAPTCHA v3 (proteção do formulário de inscrição)
# Crie um par de chaves em: https://www.google.com/recaptcha/admin/create
# Tipo: reCAPTCHA v3. Adicione seus domínios (localhost + domínio de produção).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6LXXXXXXXXXXXXXXXXXXXXXX"
RECAPTCHA_SECRET_KEY="6LXXXXXXXXXXXXXXXXXXXXXX"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Carreiras WG Baterias"
