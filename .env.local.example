# =============================================================
# PORTAL DE CARREIRAS — WG BATERIAS
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local — ele está no .gitignore.
# =============================================================

# Banco de dados (PostgreSQL — Neon ou outro)
# Formato: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth.js
# Gere com: openssl rand -base64 32  (ou qualquer string longa aleatória)
NEXTAUTH_SECRET="GERE_UMA_STRING_ALEATORIA_LONGA_AQUI"
NEXTAUTH_URL="http://localhost:3000"

# Claude API (Anthropic)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-XXXXXXXXXXXXX"

# Resend (e-mails transacionais)
# Obtenha em: https://resend.com/
RESEND_API_KEY="re_XXXXXXXXXXXXX"
RESEND_FROM_EMAIL="carreiras@wgbaterias.com.br"

# Upload de arquivos
# "local" para desenvolvimento, "r2" para produção (Cloudflare R2)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="5"

# Cloudflare R2 (somente em produção, quando STORAGE_PROVIDER="r2")
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Carreiras WG Baterias"
