// Portal de Carreiras — WG Baterias
// Prisma Schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Usuários internos (RH) ───────────────────────────────────────────────────

enum UserRole {
  ADMIN_RH     // Acesso total: criar/editar/encerrar vagas
  VIEWER_RH    // Somente leitura: ver vagas
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(VIEWER_RH)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

// NextAuth sessions (opcional — usado se migrar para OAuth)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  @@map("sessions")
}

// ─── Vagas ────────────────────────────────────────────────────────────────────

enum JobStatus {
  ACTIVE    // Publicada no portal
  PAUSED    // Pausada temporariamente (não aparece no portal)
  CLOSED    // Encerrada
}

enum Modality {
  PRESENTIAL  // Presencial
  REMOTE      // Remoto
  HYBRID      // Híbrido
}

enum ContractType {
  CLT
  PJ
  INTERNSHIP    // Estágio
  APPRENTICE    // Jovem aprendiz
  TEMPORARY     // Temporário
  OTHER
}

model Job {
  id                   String       @id @default(cuid())
  title                String
  department           String?
  city                 String
  state                String       // UF (ex: "SP")
  modality             Modality
  contractType         ContractType @default(CLT)
  description          String       @db.Text
  responsibilities     String       @db.Text
  requiredRequirements String       @db.Text
  desiredRequirements  String?      @db.Text
  benefits             String?      @db.Text
  workSchedule         String?      // Ex: "Seg a Sex, 08h-17h"
  closingDate          DateTime?    // Data limite opcional
  tallyFormUrl         String?      // Link do formulário Tally para candidatura
  status               JobStatus    @default(ACTIVE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("jobs")
}
